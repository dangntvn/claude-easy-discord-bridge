# Copy file này thành `.env` trong cùng thư mục rồi điền giá trị thật.
# KHÔNG commit `.env` — đã có sẵn trong .gitignore.

# Token của bot Discord.
# Discord Developer Portal > Applications > <app của bạn> > Bot > Reset Token.
# Nhớ bật "Message Content Intent" ở cùng trang đó, nếu không bot sẽ không đọc
# được nội dung tin nhắn.
DISCORD_BOT_TOKEN=

# ID của server (guild) chứa channel dùng cho project này.
# Bật Discord > Settings > Advanced > Developer Mode, rồi chuột phải vào tên
# server > Copy Server ID.
DISCORD_SERVER_ID=

# ID của channel cha — mỗi project dùng 1 channel riêng. Skill sẽ tự tạo thread
# con trong channel này cho từng session.
# Chuột phải vào channel > Copy Channel ID.
# Bot cần quyền: View Channel, Send Messages, Create Public Threads,
# Send Messages in Threads.
DISCORD_CHANNEL_ID=

# Danh sách user ID được phép điều khiển Claude qua Discord, cách nhau bởi dấu
# phẩy. Tin nhắn từ user ngoài danh sách này sẽ bị bỏ qua.
# Chuột phải vào tên user > Copy User ID.
ALLOWED_USER_IDS=111,222,333

# (Tuỳ chọn) Thời gian chờ trả lời cho hook duyệt quyền PermissionRequest, tính
# bằng mili giây. Mặc định 600000 (10 phút). Hết giờ mà chưa ai trả lời thì
# prompt tự rơi về hiện ở VSCode như bình thường.
# LƯU Ý: giá trị này phải NHỎ HƠN field `timeout` (tính bằng giây) của hook
# PermissionRequest trong .claude/settings.json, nếu không Claude Code sẽ giết
# tiến trình hook trước khi nó chờ xong.
# PERMISSION_APPROVAL_WAIT_MS=600000
