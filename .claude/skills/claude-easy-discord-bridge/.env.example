# Copy this file to `.env` in the same folder and fill in real values.
# Do NOT commit `.env` — it is already in .gitignore.

# Discord bot token.
# Discord Developer Portal > Applications > <your app> > Bot > Reset Token.
# Make sure to enable "Message Content Intent" on the same page, otherwise the
# bot will not be able to read message content.
DISCORD_BOT_TOKEN=

# ID of the server (guild) that contains the channel for this project.
# Enable Discord > Settings > Advanced > Developer Mode, then right-click the
# server name > Copy Server ID.
DISCORD_SERVER_ID=

# Parent channel ID — each project uses its own channel. The skill will
# automatically create a child thread in this channel for each session.
# Right-click the channel > Copy Channel ID.
# Bot permissions required: View Channel, Send Messages, Create Public Threads,
# Send Messages in Threads.
DISCORD_CHANNEL_ID=

# Comma-separated list of user IDs allowed to control Claude via Discord.
# Messages from users not in this list will be ignored.
# Right-click the username > Copy User ID.
ALLOWED_USER_IDS=111,222,333

# (Optional) Wait time for PermissionRequest hook approval, in milliseconds.
# Default: 600000 (10 minutes). If no one responds before timeout, the prompt
# falls back to VSCode as normal.
# NOTE: this value must be SMALLER than the hook `timeout` field (in seconds)
# of the PermissionRequest hook in .claude/settings.json, otherwise Claude Code
# will kill the hook process before it finishes waiting.
# PERMISSION_APPROVAL_WAIT_MS=600000
